# Based on CachyOS/cachyos-hypr-noctalia's default etc/skel/.config/uwsm/env.
# Deploys to ~/.config/uwsm/env. Read by uwsm before Hyprland starts, so this is
# where NVIDIA/IM env vars belong regardless of which SDDM session entry is used
# ("Hyprland" or "Hyprland (uwsm managed)") — CachyOS's own autostart.lua runs
# `dbus-update-activation-environment --systemd --all` on every session start either
# way, so systemd --user services (like vicinae.service) see these too.

export BROWSER=firefox
export TERM=xterm-kitty
export QT_QPA_PLATFORM="wayland;xcb"
export QT_QPA_PLATFORMTHEME="qt6ct"
export ELECTRON_OZONE_PLATFORM_HINT=auto
export HYPRCURSOR_THEME="Bibata-Modern-Ice"
export HYPRCURSOR_SIZE=24
export XCURSOR_THEME="Bibata-Modern-Ice"
export XCURSOR_SIZE=24

# NVIDIA Optimus — this laptop's recurring pain point, uncommented (upstream ships
# these commented out by default).
export GBM_BACKEND=nvidia-drm
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export LIBVA_DRIVER_NAME=nvidia
export NVD_BACKEND=direct
export WLR_NO_HARDWARE_CURSORS=1

# fcitx5 input method (Korea prep).
# GTK_IM_MODULE deliberately NOT set: on native Wayland, GTK3/4 apps talk to
# fcitx5 directly over the Wayland input-method protocol, and forcing the old
# X11-style module conflicts with that (this is literally what fcitx5's own
# "Wayland diagnose" warning was reporting — confirmed via fcitx-im.org's own
# Wayland setup docs, not a guess).
export QT_IM_MODULE=fcitx      # Qt on Wayland still benefits from this for Qt5 apps
export XMODIFIERS=@im=fcitx    # for XWayland / legacy X11 apps only
export SDL_IM_MODULE=fcitx     # for SDL2 apps not defaulting to Wayland
